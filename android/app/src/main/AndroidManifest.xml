<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Owning this service is what lets the notification carry live
             distance and a pause button; a foreground service of type
             location is also the only way Android keeps giving an app
             position once the screen is off. -->
        <service
            android:name=".RecordingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

    </application>

    <!-- Permissions -->

    <!-- satellite imagery and elevation tiles are fetched at runtime -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- the record button. COARSE is declared alongside FINE because Android 12
         and later let the user grant only the approximate one, and the app has
         to cope with that rather than refuse to start. Background recording
         will need FOREGROUND_SERVICE_LOCATION as well; not yet, because nothing
         here records with the screen off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Declared here rather than inherited from a plugin's manifest, now that
         the recording service is ours. FOREGROUND_SERVICE_LOCATION is what
         Android 14 and later require to start a service of that type, and
         POST_NOTIFICATIONS is what Android 13 and later require before any
         notification is shown at all — including the one the service must
         display to exist. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GPS is how this app is meant to be used, but the viewer works without
         it, so the hardware is optional and the Play listing stays open to
         tablets that have none -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
